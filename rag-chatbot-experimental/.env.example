ENVIRONMENT=development
LLM_PROVIDER=ollama
OPENROUTER_MODEL=openai/gpt-oss-20b:free
OLLAMA_MODEL=qwen2.5:1.5b-instruct
EMBEDDING_MODEL=nomic-embed-text
FRONTEND_ORIGIN=http://localhost:5173
SHAREPOINT_TENANT_ORIGIN=https://hopitalmontfort.sharepoint.com
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://hopitalmontfort.sharepoint.com,https://URL_FRONTEND_CHATBOT
ALLOWED_ORIGINS_PRODUCTION=https://URL_FRONTEND_CHATBOT,https://hopitalmontfort.sharepoint.com
CSP_FRAME_ANCESTORS="'self' http://localhost:5173 https://hopitalmontfort.sharepoint.com"
PUBLIC_API_BASE_URL=http://127.0.0.1:8010
AUTH_ENABLED=false
AUTH_PROVIDER=none
DEMO_AUTH_TOKEN=
DEMO_ADMIN_AUTH_TOKEN=
ENTRA_TENANT_ID=
ENTRA_CLIENT_ID=
ENTRA_AUDIENCE=
ENTRA_ISSUER=
AUTH_REQUIRED_GROUPS=
CONVERSATION_HISTORY_LIMIT=10
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_LLM_MODEL=qwen2.5:1.5b-instruct
OLLAMA_EMBEDDING_MODEL=nomic-embed-text
OLLAMA_NUM_CTX=4096
OLLAMA_NUM_PREDICT=512
OLLAMA_TEMPERATURE=0.1
OLLAMA_THINK=false
OLLAMA_KEEP_ALIVE=10m
VECTOR_DB_TYPE=chroma
CHROMA_PERSIST_DIR=data/vector_store
DOCUMENTS_DIR=data/documents
TOP_K=5
CHUNK_SIZE=1000
CHUNK_OVERLAP=150
DEFAULT_LANGUAGE=fr
RETRIEVAL_MIN_SCORE=0.15
RAG_QUERY_REWRITE_ENABLED=true
RAG_QUERY_REWRITE_PROVIDER=ollama
RAG_QUERY_REWRITE_MAX_TOKENS=128
RAG_HYBRID_SEARCH_ENABLED=true
RAG_VECTOR_TOP_K=12
RAG_KEYWORD_TOP_K=12
RAG_FINAL_TOP_K=5
RAG_KEYWORD_WEIGHT=0.35
RAG_VECTOR_WEIGHT=0.65
RAG_RERANK_ENABLED=true
RAG_RERANK_METHOD=heuristic
RAG_RERANK_TOP_K=5
RAG_CONFIDENCE_ENABLED=true
RAG_MIN_CONFIDENCE=0.35
RAG_LOW_CONFIDENCE_MARGIN=0.08
RAG_DIVERSITY_ENABLED=true
RAG_MAX_CHUNKS_PER_DOCUMENT=2
# POC local : false = tous les profils voient les mêmes documents.
# Future production SharePoint : true = filtrage selon les groupes/permissions.
RAG_PERMISSION_FILTERING_ENABLED=false
REQUEST_TIMEOUT_SECONDS=120
MAX_CONTEXT_CHARS=12000
EMBEDDING_BATCH_SIZE=32
SUPPRESS_HTTPX_INFO_LOGS=true
SHAREPOINT_SIMULATOR_ENABLED=false
SHAREPOINT_SIMULATOR_STATE_PATH=data/sharepoint_simulator/index_state.json
SHAREPOINT_SIMULATOR_PERMISSIONS_PATH=data/sharepoint_simulator/permissions.json
SHAREPOINT_SIMULATOR_LOG_PATH=logs/sharepoint_simulator.log
RAG_AUDIT_LOG_ENABLED=false
RAG_AUDIT_LOG_PATH=logs/rag_queries.jsonl
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_ENABLED=false
OPENROUTER_ALLOW_DOCUMENT_CONTEXT=false
OPENROUTER_MAX_REQUESTS_PER_RUN=40
OPENROUTER_TIMEOUT_SECONDS=120
OPENROUTER_REQUEST_DELAY_SECONDS=35
OPENROUTER_MAX_MODELS_PER_RUN=3
OPENROUTER_MAX_QUESTIONS_PER_RUN=3
OPENROUTER_RETRY_ON_429=true
OPENROUTER_MAX_RETRIES=1

# SharePoint integration target
# Remplacer https://URL_FRONTEND_CHATBOT et https://URL_BACKEND_FASTAPI par les URL HTTPS validées.
# ENVIRONMENT=demo
# LLM_PROVIDER=mock
